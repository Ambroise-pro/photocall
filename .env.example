# Variables à définir dans Vercel : Project > Settings > Environment Variables
# (ou dans un fichier .env.local pour `vercel dev`).

# Nombre maximum de badges proposés sur l'écran d'accueil (0 à MAX_BADGES)
MAX_BADGES=8

# Effet miroir sur la caméra (comme un selfie). false pour le désactiver.
MIRROR=true

# Code de l'écran "Gestion des photos" (icône ⚙ en haut à gauche de l'accueil)
ADMIN_PIN=1234

# --- Envoi des photos par e-mail (laisser SMTP_HOST vide pour désactiver) ---
# Exemple Gmail : activez la validation en 2 étapes puis créez un
# "mot de passe d'application" (https://myaccount.google.com/apppasswords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=votre.adresse@gmail.com
SMTP_PASS=mot-de-passe-application
MAIL_FROM="Soirée santé <votre.adresse@gmail.com>"
MAIL_SUBJECT=Votre photo de la soirée santé 📸
# MAIL_TEXT=Texte du mail ({badges} est remplacé par le nombre de badges)
